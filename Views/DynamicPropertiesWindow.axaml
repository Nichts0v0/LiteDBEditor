<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiteDBEditor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:LiteDBEditor.Converters"
        xmlns:dataConv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
        x:Class="LiteDBEditor.Views.DynamicPropertiesWindow"
        x:DataType="vm:DynamicPropertiesViewModel"
        Title="{Binding Title}"
        Icon="/Assets/ldbe-256.ico"
        WindowStartupLocation="CenterOwner"
        Width="500" Height="600">
    <Window.Resources>
    </Window.Resources>

    <Window.Styles>
        <!-- 输入框错误状态：强制背景和边框 -->
        <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFF0F0"/>
        </Style>
        <Style Selector="CheckBox.error /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource SemiColorText0}"/>

        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Properties}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DynamicPropertyItemViewModel">
                        <StackPanel Margin="0,0,0,12">
                            <!-- Property Item Card -->
                            <Border Background="{DynamicResource SemiColorFill0}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                        <!-- Expand/Collapse Button for Complex Types -->
                                        <Button Grid.Column="0" Theme="{DynamicResource BorderlessButton}"
                                                Width="24" Height="24" Padding="0"
                                                IsVisible="{Binding IsComplexEditorVisible}"
                                                Command="{Binding ToggleExpandCommand}"
                                                Margin="0,0,8,0">
                                            <PathIcon Data="{Binding IsExpanded, Converter={x:Static conv:ObjectConverters.ExpandIconConverter}}" 
                                                      Width="10" Height="10" />
                                        </Button>

                                        <!-- Display Name or Key Input -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                            <!-- Key Input for Dictionary Items -->
                                            <TextBox Text="{Binding DictItemKey, Mode=TwoWay}"
                                                     IsVisible="{Binding IsDictionaryItem}"
                                                     IsReadOnly="{Binding IsReadOnly}"
                                                     Watermark="Key"
                                                     MinWidth="120"
                                                     Classes.error="{Binding ErrorMessage, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}" />
                                            
                                            <!-- Display Name for regular properties -->
                                            <TextBlock Text="{Binding DisplayName}" 
                                                       IsVisible="{Binding !IsDictionaryItem}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" 
                                                       Foreground="{DynamicResource SemiColorText1}" />

                                            <TextBlock Text="{Binding TypeNameDisplay}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource SemiColorText3}"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.7"/>
                                        </StackPanel>

                                        <!-- Value Editor or Preview -->
                                        <Panel Grid.Column="2" MinWidth="150" VerticalAlignment="Center">
                                            <!-- String Editor -->
                                            <TextBox Text="{Binding Value, Mode=TwoWay}" 
                                                     IsVisible="{Binding IsStringEditorVisible}" 
                                                     IsReadOnly="{Binding IsReadOnly}"
                                                     Classes.error="{Binding ErrorMessage, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}" />
         
                                            <!-- Numeric Editor -->
                                            <TextBox Text="{Binding Value, Mode=TwoWay}"
                                                     IsVisible="{Binding IsNumericEditorVisible}"
                                                     IsReadOnly="{Binding IsReadOnly}"
                                                     Loaded="OnNumericTextBoxLoaded"
                                                     Classes.error="{Binding ErrorMessage, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}" />
         
                                            <!-- Boolean Editor -->
                                            <CheckBox IsChecked="{Binding Value, Mode=TwoWay}"
                                                      IsVisible="{Binding IsBooleanEditorVisible}" 
                                                      IsEnabled="{Binding !IsReadOnly}"
                                                      Theme="{DynamicResource PureCheckBox}"
                                                      Classes.error="{Binding ErrorMessage, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}" />
         
                                            <!-- Complex Type Preview -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsComplexEditorVisible}">
                                                <TextBlock Text="{Binding ComplexTypePreview}" 
                                                           VerticalAlignment="Center" FontSize="12" 
                                                           Foreground="{DynamicResource SemiColorText3}"
                                                           FontStyle="Italic"/>
                                                <Button Theme="{DynamicResource BorderlessButton}"
                                                        Foreground="{DynamicResource SemiColorPrimary}"
                                                        ToolTip.Tip="添加项"
                                                        IsVisible="{Binding CanAddChildren}"
                                                        Command="{Binding AddChildCommand}">
                                                    <PathIcon Data="{StaticResource IconPlus}" Width="12" Height="12"/>
                                                </Button>
                                            </StackPanel>
                                        </Panel>

                                        <!-- Remove Button for items that can be removed -->
                                        <Button Grid.Column="3" Theme="{DynamicResource BorderlessButton}"
                                                Foreground="{DynamicResource SemiColorDanger}"
                                                IsVisible="{Binding CanRemove}"
                                                Command="{Binding RemoveSelfCommand}"
                                                Margin="8,0,0,0">
                                            <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                    
                                    <!-- Error Message -->
                                    <TextBlock Text="{Binding ErrorMessage}" 
                                               IsVisible="{Binding ErrorMessage, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11" Foreground="{DynamicResource SemiColorDanger}"
                                               Margin="32,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Recursive Children -->
                            <Border IsVisible="{Binding IsExpanded}"
                                    Margin="32,4,0,0"
                                    BorderBrush="{DynamicResource SemiColorBorder}"
                                    BorderThickness="2,0,0,0"
                                    Padding="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{Binding $parent[ItemsControl].ItemTemplate}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
 
        <!-- Footer Area -->
        <Border Grid.Row="2" Background="{DynamicResource SemiColorFill1}" CornerRadius="12" Padding="16" Margin="0,16,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <!-- Status/Error Box -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                    <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14" 
                              Foreground="{Binding WindowErrorMessage, Converter={x:Static vm:WindowConverters.ErrorForegroundConverter}}"/>
                    <TextBlock Text="{Binding WindowErrorMessage, FallbackValue='数据验证中...'}" 
                               Foreground="{Binding WindowErrorMessage, Converter={x:Static vm:WindowConverters.ErrorForegroundConverter}}" 
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
 
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Theme="{DynamicResource LightButton}" Content="取消" Width="100" Click="OnCancelClick" IsCancel="True"/>
                    <Button Theme="{DynamicResource SolidButton}" Content="保存修改" Width="120" Click="OnSaveClick" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
