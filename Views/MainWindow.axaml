<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LiteDBEditor.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:LiteDBEditor.Converters"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="LiteDBEditor.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/ldbe-256.ico"
        Title="{Binding WindowTitle}">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <conv:ModifiedFieldColorConverter x:Key="ModifiedColorConverter"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBox.error /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#FFF0F0"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260, 1, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SemiColorFill0}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Grid.Row="0" Margin="16" Spacing="12">
                    <TextBlock Text="LiteDB Editor" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource SemiColorText0}"/>
                    
                    <Button Theme="{DynamicResource SolidButton}" 
                            HorizontalAlignment="Stretch" 
                            Click="OnOpenDatabaseClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16"/>
                            <TextBlock Text="打开数据库..."/>
                        </StackPanel>
                    </Button>
                    
                    <Button Theme="{DynamicResource LightButton}" 
                            HorizontalAlignment="Stretch" 
                            Click="OnNewDatabaseClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                            <TextBlock Text="新建数据库..."/>
                        </StackPanel>
                    </Button>

                    <Separator Margin="0,8" Background="{DynamicResource SemiColorBorder}"/>
                    
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" 
                                   Text="{Binding CurrentDbFileName, StringFormat='集合 ({0})', TargetNullValue='集合'}" 
                                   FontSize="13"
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource SemiColorText2}"
                                   VerticalAlignment="Center" 
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" 
                                Theme="{DynamicResource BorderlessButton}"
                                Width="28" Height="28" Padding="0" 
                                Click="OnAddCollectionClick" 
                                ToolTip.Tip="新建集合" 
                                IsEnabled="{Binding IsDatabaseLoaded}">
                            <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                </StackPanel>
                
                <ListBox Grid.Row="1" 
                         Margin="8,0,8,8"
                         Background="Transparent"
                         ItemsSource="{Binding Collections}"
                         SelectedItem="{Binding SelectedCollection}">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontSize="14"/>
                                <Button Grid.Column="1" 
                                        Theme="{DynamicResource BorderlessButton}"
                                        Foreground="{DynamicResource SemiColorDanger}" 
                                        Width="24" Height="24" Padding="0"
                                        Click="OnDeleteSpecificCollectionClick" 
                                        ToolTip.Tip="删除此集合">
                                    <PathIcon Data="{StaticResource IconDelete}" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="16" IsVisible="{Binding IsDatabaseLoaded}">
                     <TextBlock Text="数据库已连接" FontSize="11" Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Splitter (Hidden but functional) -->
        <GridSplitter Grid.Column="1" Width="1" Background="Transparent"/>

        <!-- Main Content Area -->
        <!-- Main Content Area -->
        <Grid Grid.Column="2" Margin="20,16">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="12"
                        IsVisible="{Binding SelectedCollection, Converter={x:Static conv:ObjectConverters.IsNull}}">
                <PathIcon Data="{StaticResource IconDocument}" Width="48" Height="48" Foreground="{DynamicResource SemiColorDisabledText}"/>
                <TextBlock Text="请选择一个集合以查看数据" 
                           FontSize="16"
                           Foreground="{DynamicResource SemiColorText3}" />
            </StackPanel>
                       
            <Grid IsVisible="{Binding SelectedCollection, Converter={x:Static conv:ObjectConverters.IsNotNull}}" RowDefinitions="Auto, Auto, *">
                <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="*, Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding SelectedCollection}" 
                                   FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource SemiColorText0}"/>
                        <Border Background="{DynamicResource SemiColorPrimary4}" 
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center"
                                IsVisible="{Binding CurrentBoundCsFileName, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                             <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" Foreground="{DynamicResource SemiColorPrimary}"/>
                                <TextBlock Text="{Binding CurrentBoundCsFileName}" 
                                           Foreground="{DynamicResource SemiColorPrimary}" FontSize="12" FontWeight="SemiBold"/>
                             </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Action Toolbar -->
                <Border Grid.Row="1" Background="{DynamicResource SemiColorFill1}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Theme="{DynamicResource LightButton}" Click="OnBindSchemaClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14"/>
                                    <TextBlock Text="绑定模板"/>
                                </StackPanel>
                            </Button>
                            <Button Theme="{DynamicResource LightButton}" Click="OnNewDocumentClick">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14"/>
                                    <TextBlock Text="新增记录"/>
                                </StackPanel>
                            </Button>
                            
                            <Separator Classes="Vertical" Margin="8,4" Background="{DynamicResource SemiColorBorder}"/>
                            
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasUnsavedChanges}">
                                <Button Theme="{DynamicResource SolidButton}" Classes="Success" Command="{Binding SaveChangesCommand}" HotKey="Ctrl+S">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14"/>
                                        <TextBlock Text="保存修改"/>
                                    </StackPanel>
                                </Button>
                                <Button Theme="{DynamicResource LightButton}" Classes="Danger" Command="{Binding CancelChangesCommand}" HotKey="Escape">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconCancel}" Width="14" Height="14"/>
                                        <TextBlock Text="放弃"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" Text="⚠ 有未保存的更改" 
                                   Foreground="{DynamicResource SemiColorWarning}" 
                                   VerticalAlignment="Center" FontWeight="SemiBold" 
                                   IsVisible="{Binding HasUnsavedChanges}"/>
                    </Grid>
                </Border>
                
                <DataGrid x:Name="MainDataGrid" 
                          Grid.Row="2" 
                          ItemsSource="{Binding Documents}" 
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserSortColumns="True"
                          GridLinesVisibility="All"
                          HeadersVisibility="All"
                          SelectionMode="Extended"
                          BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                          PointerPressed="OnDataGridPointerPressed"
                          BeginningEdit="OnDataGridBeginningEdit"
                          CellEditEnding="OnDataGridCellEditEnding">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="操作" IsReadOnly="True" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left" Margin="12,4,4,4">
                                        <Button Theme="{DynamicResource BorderlessButton}"
                                                Click="OnEditDocumentClick" 
                                                ToolTip.Tip="编辑 JSON">
                                            <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" Foreground="{DynamicResource SemiColorText2}"/>
                                        </Button>
                                        <Button Theme="{DynamicResource BorderlessButton}"
                                                Click="OnDeleteDocumentClick" 
                                                Foreground="{DynamicResource SemiColorDanger}"
                                                ToolTip.Tip="删除记录">
                                            <PathIcon Data="{StaticResource IconDelete}" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Grid>

            <!-- Error Notification Toast -->
            <Border HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Margin="0,0,0,0"
                    Background="{DynamicResource SemiColorDanger0}"
                    BorderBrush="{DynamicResource SemiColorDanger1}"
                    BorderThickness="1"
                    CornerRadius="8" 
                    Padding="16,12"
                    MaxWidth="450"
                    BoxShadow="0 8 24 0 #20CC4444"
                    IsVisible="{Binding GridErrorMessage, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Data="{StaticResource IconWarning}" Foreground="{DynamicResource SemiColorDanger}" Width="20" Height="20" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="验证错误" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SemiColorDanger}"/>
                        <TextBlock Text="{Binding GridErrorMessage}" 
                                   Foreground="{DynamicResource SemiColorDanger}" 
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
