<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiteDBEditor.Views.PrimitiveInputDialog"
        Title="输入值"
        Icon="/Assets/ldbe-256.ico"
        Width="400" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid Margin="20" RowDefinitions="Auto, Auto, Auto">
        <!-- 提示文字 -->
        <TextBlock x:Name="PromptText" Grid.Row="0" Text="请输入值："
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource SemiColorText1}"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
 
        <!-- 文字输入框 -->
        <TextBox x:Name="InputBox" Grid.Row="1" Classes="Large" Margin="0,0,0,20"/>
 
        <!-- 布尔输入 -->
        <CheckBox x:Name="BoolBox" Grid.Row="1" Content="开启 / True"
                  Theme="{DynamicResource PureCheckBox}"
                  Margin="0,0,0,20" IsVisible="False"/>
 
        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="12">
            <Button Theme="{DynamicResource LightButton}" Content="取消" Width="80" Click="OnCancelClick" IsCancel="True"/>
            <Button Theme="{DynamicResource SolidButton}" Content="确定" Width="80" Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
